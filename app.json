{
  "expo": {
    "name": "SuperRH",
    "slug": "superrh",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "superrh",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F4F0EA",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.superrh.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4F0EA"
      },
      "package": "com.superrh.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
        "color": "#B8973A"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
