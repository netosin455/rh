# ============================================================
# Variáveis de ambiente para deploy na AWS
# Copie este arquivo para .env e preencha os valores
# ============================================================

# NeonDB — mesma string de conexão que você já usa
DATABASE_URL=postgresql://usuario:senha@host/neondb?sslmode=require

# Segredo para assinar os tokens JWT (use uma string longa e aleatória)
JWT_SECRET=troque-por-um-segredo-seguro

# Chave da API do Groq (https://console.groq.com)
GROQ_API_KEY=gsk_...

# URL da API Gateway gerada após o deploy do SAM
# Defina isso no Amplify Hosting como variável de ambiente do frontend
EXPO_PUBLIC_API_URL=https://xxxxxxxxxx.execute-api.sa-east-1.amazonaws.com
